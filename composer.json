{
    "name": "firetext/php-sdk",
    "description": "A PHP SDK for the FireText.co.uk API",
    "require": {
        "laminas/laminas-hydrator": "~4.3"
        "illuminate/log": "^5.8",
        "illuminate/support": "^5.8",
        "illuminate/container": "^5.8",
        "illuminate/config": "^5.8",
        "illuminate/events": "^5.8"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.19 || ^3.0",
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0",
        "php-coveralls/php-coveralls": "^2.5"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "FireText",
            "email": "hello@firetext.co.uk"
        }
    ],
    "autoload": {
        "psr-0": {
            "FireText": "src/"
        },
        "classmap": [
            "tests/"
        ]
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": false
        }
    }
}
